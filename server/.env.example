# ============ MUNCH BOX — SERVER ENV ============
# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored on purpose.

# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/munchbox

# Signing key for login tokens. At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start if this is missing or too short.
JWT_SECRET=

# How long a login stays valid
JWT_EXPIRES_IN=2h

# Which frontends may call this API (comma separated, no trailing slash).
# In production this must list your real domain only.
CLIENT_ORIGINS=https://munchhbox.com,https://www.munchhbox.com

# Set to "production" on Render. This also turns on the
# HTTPS redirect and hides internal error details.
NODE_ENV=development

# ---------- IMAGE STORAGE ----------
# Render wipes its disk on every deploy, so product photos
# saved locally disappear. With these three set, images go
# to Cloudinary instead and survive deploys.
# Free account: https://cloudinary.com  ->  Dashboard
# Leave blank locally to use the local uploads folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
