# ============ MUNCH BOX — CLIENT ENV ============
# Copy this file to .env and fill in real values.
# Anything starting with VITE_ is bundled into the
# public JavaScript, so never put a secret here.

# Backend API. Leave unset locally to fall back to
# http://localhost:5000. No trailing slash.
VITE_API_URL=https://munchbox-api.onrender.com

# Public site URL. Used for canonical tags, sitemap.xml
# and social share previews. No trailing slash.
VITE_SITE_URL=https://munchhbox.com
